<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".EmailApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZYEmail"
        tools:targetApi="31">

        <!-- 启动页：应用入口。冷启动先经 Splash 主题显示品牌背景，
             再路由：无账户 → LoginActivity；有账户 → 直接进入内容。
             之前的入口是 LoginActivity，导致每次启动都先闪登录页。 -->
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZYEmail.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录页：仅由 MainActivity 路由（无账户）或"添加账户"进入 -->
        <activity
            android:name=".ui.activity.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activity.ComposeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activity.AccountSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.activity.MainActivity" />

        <activity
            android:name=".ui.activity.MessageDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.activity.MainActivity" />

    </application>

</manifest>
