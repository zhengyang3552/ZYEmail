<?xml version="1.0" encoding="utf-8"?>
<!--
    账户列表项
    ——————————————————————————————————————————————————————————————————
    以"图标容器 + 主/次信息 + 前进指示"组成标准 M3 列表项结构，
    整块卡片可点击，触控区域远大于 48dp。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    style="@style/Widget.ZYEmail.Card.Account"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginBottom="@dimen/space_1"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_4">

        <FrameLayout
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_logo_circle">

            <ImageView
                android:id="@+id/ivAccountIcon"
                android:layout_width="@dimen/icon_default"
                android:layout_height="@dimen/icon_default"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_email"
                app:tint="@color/m3_primary" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAccountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ZYEmail.TitleMedium"
                android:textColor="@color/m3_on_surface"
                tools:text="zhengyang@qq.com" />

            <TextView
                android:id="@+id/tvAccountType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ZYEmail.BodySmall"
                android:textColor="@color/m3_on_surface_variant"
                tools:text="SMTP / IMAP · imap.qq.com" />

        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_default"
            android:layout_height="@dimen/icon_default"
            android:layout_marginStart="@dimen/space_2"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
