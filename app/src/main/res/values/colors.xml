<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 颜色令牌 · 浅色方案
    ——————————————————————————————————————————————————————————————————
    与 values-night/colors.xml 使用完全相同的令牌名称。
    生成方式：material-color-utilities（HCT 色彩空间）+ 统一品牌种子色，
    由统一设计规范一次性生成，请勿手工逐条修改。
    统一种子色：primary #0B57D0 · error #B3261E · success #146C2E · warning #8B5000
-->

<resources>
    <!-- ========== Primary：品牌蓝（seed #0B57D0） ========== -->
    <color name="m3_primary">#FF0856CF</color>
    <color name="m3_on_primary">#FFFFFFFF</color>
    <color name="m3_primary_container">#FFDAE2FF</color>
    <color name="m3_on_primary_container">#FF001847</color>

    <!-- ========== Secondary：低饱和蓝灰，用于次级按钮/标签 ========== -->
    <color name="m3_secondary">#FF585E71</color>
    <color name="m3_on_secondary">#FFFFFFFF</color>
    <color name="m3_secondary_container">#FFDCE2F9</color>
    <color name="m3_on_secondary_container">#FF151B2C</color>

    <!-- ========== Tertiary：青绿色（primary 色相 +60），用于附件/强调标记 ========== -->
    <color name="m3_tertiary">#FF735471</color>
    <color name="m3_on_tertiary">#FFFFFFFF</color>
    <color name="m3_tertiary_container">#FFFED7F9</color>
    <color name="m3_on_tertiary_container">#FF2B122B</color>

    <!-- ========== Surface：表面层级（由低到高，用于建立视觉层次） ========== -->
    <color name="m3_surface">#FFFBF8FD</color>
    <color name="m3_on_surface">#FF1B1B1F</color>
    <color name="m3_surface_variant">#FFE1E2EC</color>
    <color name="m3_on_surface_variant">#FF45464F</color>
    <color name="m3_surface_container_lowest">#FFFFFFFF</color>
    <color name="m3_surface_container_low">#FFF5F3F7</color>
    <color name="m3_surface_container">#FFEFEDF1</color>
    <color name="m3_surface_container_high">#FFE9E7EC</color>
    <color name="m3_surface_container_highest">#FFE4E2E6</color>
    <color name="m3_surface_inverse">#FF303034</color>
    <color name="m3_on_surface_inverse">#FFF2F0F4</color>
    <color name="m3_primary_inverse">#FFB2C5FF</color>

    <!-- ========== Outline：描边与分隔线 ========== -->
    <color name="m3_outline">#FF757780</color>
    <color name="m3_outline_variant">#FFC5C6D0</color>

    <!-- ========== 语义状态色 ========== -->
    <color name="m3_error">#FFB4271F</color>
    <color name="m3_on_error">#FFFFFFFF</color>
    <color name="m3_error_container">#FFFFDAD5</color>
    <color name="m3_on_error_container">#FF410001</color>

    <color name="m3_success">#FF156D2F</color>
    <color name="m3_on_success">#FFFFFFFF</color>
    <color name="m3_success_container">#FFA1F6A8</color>
    <color name="m3_on_success_container">#FF002108</color>

    <color name="m3_warning">#FF8B5000</color>
    <color name="m3_on_warning">#FFFFFFFF</color>
    <color name="m3_warning_container">#FFFFDCBE</color>
    <color name="m3_on_warning_container">#FF2D1600</color>

    <!-- ========== 交互叠加层（state layer / ripple） ========== -->
    <color name="m3_ripple">#1F000000</color>
</resources>
