<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        字体层级 · 对齐 Material 3 Type Scale
        ——————————————————————————————————————————————————————————————————
        M3 的层级不是"大小递增"，而是"角色分工"：
          Headline  页面主标题（登录页品牌名）
          Title     卡片/区块标题（邮件主题、账户名）
          Body      正文与辅助说明（预览、地址、时间）
          Label     按钮、标签、小节标题
        每级同时固定 lineHeight 与 letterSpacing，保证多行文本的
        垂直节奏一致，这也是原项目最欠缺的部分。
    -->
    <style name="TextAppearance.ZYEmail.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ZYEmail.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline_small</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ZYEmail.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ZYEmail.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:letterSpacing">0.009</item>
    </style>

    <style name="TextAppearance.ZYEmail.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_title_small</item>
        <item name="android:letterSpacing">0.007</item>
    </style>

    <style name="TextAppearance.ZYEmail.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.ZYEmail.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:letterSpacing">0.017</item>
    </style>

    <style name="TextAppearance.ZYEmail.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:letterSpacing">0.033</item>
    </style>

    <style name="TextAppearance.ZYEmail.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label_large</item>
        <item name="android:letterSpacing">0.007</item>
    </style>

    <style name="TextAppearance.ZYEmail.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_label_medium</item>
        <item name="android:letterSpacing">0.042</item>
    </style>

    <style name="TextAppearance.ZYEmail.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_label_small</item>
        <item name="android:letterSpacing">0.045</item>
    </style>

    <!-- ========== 形状令牌 ========== -->
    <style name="ShapeAppearance.ZYEmail.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_small</item>
    </style>

    <style name="ShapeAppearance.ZYEmail.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_medium</item>
    </style>

    <style name="ShapeAppearance.ZYEmail.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_large</item>
    </style>

    <!-- ========== 工具栏 ========== -->
    <style name="Widget.ZYEmail.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/m3_surface</item>
        <item name="titleTextColor">@color/m3_on_surface</item>
        <item name="subtitleTextColor">@color/m3_on_surface_variant</item>
        <item name="navigationIconTint">@color/m3_on_surface_variant</item>
        <item name="titleTextAppearance">@style/TextAppearance.ZYEmail.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.ZYEmail.BodySmall</item>
    </style>

    <!-- ========== 按钮 ========== -->
    <style name="Widget.ZYEmail.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.ZYEmail.LabelLarge</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ZYEmail.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.ZYEmail.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ZYEmail.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.ZYEmail.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/m3_outline</item>
    </style>

    <style name="Widget.ZYEmail.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.ZYEmail.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ========== 输入框 ========== -->
    <style name="Widget.ZYEmail.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/shape_corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/shape_corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/shape_corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/shape_corner_medium</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/m3_on_surface_variant</item>
        <item name="android:textAppearance">@style/TextAppearance.ZYEmail.BodyLarge</item>
    </style>

    <!-- ========== 卡片 ========== -->
    <style name="Widget.ZYEmail.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/m3_surface_container_low</item>
        <item name="cardCornerRadius">@dimen/shape_corner_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/m3_outline_variant</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="rippleColor">@color/m3_ripple</item>
    </style>

    <style name="Widget.ZYEmail.Card.Account">
        <item name="cardCornerRadius">@dimen/shape_corner_large</item>
    </style>

    <style name="Widget.ZYEmail.Card.Message">
        <item name="cardCornerRadius">@dimen/shape_corner_medium</item>
    </style>

    <!-- ========== 标签 Chip ========== -->
    <style name="Widget.ZYEmail.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.ZYEmail.LabelLarge</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStrokeColor">@color/m3_outline</item>
    </style>

    <!-- ========== 对话框 ========== -->
    <style name="ThemeOverlay.ZYEmail.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/m3_surface_container_high</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorPrimary">@color/m3_primary</item>
    </style>

</resources>
